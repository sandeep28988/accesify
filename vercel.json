{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/((?!assets/|src/|favicon|robots|sitemap).*|.*\\.(?:html)?)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}

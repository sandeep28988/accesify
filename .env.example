# VALOIR ENVIRONMENT VARIABLES (TEMPLATE)
# Duplicate this file to '.env' and populate with your credentials.

# 1. Supabase Credentials (Optional Fallback Backend)
# Settle these parameters to switch from localStorage engine to persistent postgres tables.
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anonymous-public-key

# 2. Razorpay Payment Credentials
# Set these to configure your checkout payment integrations in staging or production.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
VITE_RAZORPAY_KEY_SECRET=your_key_secret

# 3. WhatsApp Sales Number
# The mobile number receiving structured e-commerce dispatch orders (include country code).
VITE_WHATSAPP_SUPPORT_PHONE=919876543210
